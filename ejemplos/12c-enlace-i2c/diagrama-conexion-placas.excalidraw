    {
      "id": "12c-con-039",
      "type": "text",
      "x": 92,
      "y": 548,
      "width": 816,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
