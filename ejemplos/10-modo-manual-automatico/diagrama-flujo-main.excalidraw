  "elements": [
    { "type": "text", "x": 120, "y": 15, "width": 650, "height": 30, "text": "Diagrama de Flujo — main.cpp (orquesta Led + Boton + EntradaAnalogica)", "fontSize": 16, "fontFamily": 1, "textAlign": "center" },

    { "type": "rectangle", "x": 330, "y": 60, "width": 110, "height": 40, "backgroundColor": "#d3f9d8" },
    { "type": "text", "x": 340, "y": 70, "width": 90, "height": 20, "text": "Inicio", "fontSize": 15, "fontFamily": 1, "textAlign": "center" },
    { "type": "arrow", "x": 385, "y": 100, "width": 0, "height": 25, "points": [[0,0],[0,25]] },

    { "type": "rectangle", "x": 230, "y": 125, "width": 310, "height": 90, "backgroundColor": "#d3f9d8" },
    { "type": "text", "x": 240, "y": 133, "width": 290, "height": 74, "text": "setup()\nSerial.begin(115200)\nled.begin()   boton.begin()\nSerial.println(\"[MODO] MANUAL\")", "fontSize": 11, "fontFamily": 1, "textAlign": "center" },
    { "type": "arrow", "x": 385, "y": 215, "width": 0, "height": 25, "points": [[0,0],[0,25]] },

    { "type": "rectangle", "x": 200, "y": 240, "width": 650, "height": 580, "strokeStyle": "dashed", "backgroundColor": "transparent" },
    { "type": "text", "x": 210, "y": 248, "width": 150, "height": 18, "text": "loop() - Infinito", "fontSize": 13, "fontFamily": 1 },

    { "type": "rectangle", "x": 250, "y": 275, "width": 270, "height": 40, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 258, "y": 285, "width": 254, "height": 20, "text": "boton.update()   [Boton]", "fontSize": 12, "fontFamily": 1, "textAlign": "center" },
    { "type": "arrow", "x": 385, "y": 315, "width": 0, "height": 20, "points": [[0,0],[0,20]] },

    { "type": "rectangle", "x": 250, "y": 335, "width": 270, "height": 40, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 258, "y": 345, "width": 254, "height": 20, "text": "entrada.update()   [EntradaAnalogica]", "fontSize": 11, "fontFamily": 1, "textAlign": "center" },
    { "type": "arrow", "x": 385, "y": 375, "width": 0, "height": 20, "points": [[0,0],[0,20]] },

    { "type": "diamond", "x": 235, "y": 395, "width": 300, "height": 60, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 255, "y": 415, "width": 260, "height": 25, "text": "¿boton.fuePulsado()?", "fontSize": 12, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 535, "y": 425, "width": 60, "height": 0, "points": [[0,0],[60,0]] },
    { "type": "text", "x": 540, "y": 405, "width": 30, "height": 20, "text": "SÍ", "fontSize": 11, "fontFamily": 1 },
    { "type": "rectangle", "x": 595, "y": 400, "width": 220, "height": 50, "backgroundColor": "#ffe3e3" },
    { "type": "text", "x": 602, "y": 408, "width": 206, "height": 34, "text": "automatico = !automatico\nSerial.println(modo)   [Boton]", "fontSize": 10, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 385, "y": 455, "width": 0, "height": 25, "points": [[0,0],[0,25]] },
    { "type": "text", "x": 392, "y": 458, "width": 30, "height": 20, "text": "NO", "fontSize": 11, "fontFamily": 1 },

    { "type": "diamond", "x": 235, "y": 480, "width": 300, "height": 60, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 255, "y": 500, "width": 260, "height": 25, "text": "¿automatico?", "fontSize": 13, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 535, "y": 510, "width": 60, "height": 0, "points": [[0,0],[60,0]] },
    { "type": "text", "x": 540, "y": 490, "width": 30, "height": 20, "text": "NO", "fontSize": 11, "fontFamily": 1 },
    { "type": "rectangle", "x": 595, "y": 485, "width": 220, "height": 50, "backgroundColor": "#e9ecef" },
    { "type": "text", "x": 602, "y": 493, "width": 206, "height": 34, "text": "Manual: el LED conserva\nsu último estado", "fontSize": 10, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 385, "y": 540, "width": 0, "height": 25, "points": [[0,0],[0,25]] },
    { "type": "text", "x": 392, "y": 543, "width": 30, "height": 20, "text": "SÍ", "fontSize": 11, "fontFamily": 1 },

    { "type": "rectangle", "x": 250, "y": 565, "width": 270, "height": 45, "backgroundColor": "#e8f3ff" },
    { "type": "text", "x": 258, "y": 572, "width": 254, "height": 32, "text": "voltios = entrada.leerVoltios()\nduty = (voltios/3.3) * 255   [EntradaAnalogica]", "fontSize": 9, "fontFamily": 1, "textAlign": "center" },
    { "type": "arrow", "x": 385, "y": 610, "width": 0, "height": 20, "points": [[0,0],[0,20]] },

    { "type": "rectangle", "x": 250, "y": 630, "width": 270, "height": 45, "backgroundColor": "#e8f3ff" },
    { "type": "text", "x": 258, "y": 637, "width": 254, "height": 32, "text": "led.escribirPWM(duty)   [Led]\n(ledcWrite, 5 kHz / 8 bits)", "fontSize": 10, "fontFamily": 1, "textAlign": "center" },
    { "type": "arrow", "x": 385, "y": 675, "width": 0, "height": 20, "points": [[0,0],[0,20]] },

    { "type": "diamond", "x": 235, "y": 695, "width": 300, "height": 60, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 255, "y": 715, "width": 260, "height": 25, "text": "¿duty != dutyPrevio?", "fontSize": 12, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 535, "y": 725, "width": 60, "height": 0, "points": [[0,0],[60,0]] },
    { "type": "text", "x": 540, "y": 705, "width": 30, "height": 20, "text": "SÍ", "fontSize": 11, "fontFamily": 1 },
    { "type": "rectangle", "x": 595, "y": 700, "width": 230, "height": 50, "backgroundColor": "#d0ebff" },
    { "type": "text", "x": 602, "y": 706, "width": 216, "height": 38, "text": "Serial.print(\"[AUTO] adc=...V pwm=...\")\ndutyPrevio = duty", "fontSize": 10, "fontFamily": 1, "textAlign": "center" },

    { "type": "text", "x": 392, "y": 760, "width": 260, "height": 20, "text": "NO -> continúa sin imprimir", "fontSize": 10, "fontFamily": 1, "strokeColor": "#868e96" },

    { "type": "arrow", "x": 520, "y": 790, "width": 80, "height": 495, "points": [[0,0],[80,0],[80,-495],[0,-495]] }
