{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "type": "text", "x": 260, "y": 20, "width": 380, "height": 30, "text": "Diagrama de flujo - Servo controlado por potenciómetro", "fontSize": 20, "fontFamily": 1, "textAlign": "center"
    },
    {
      "type": "rectangle", "x": 350, "y": 80, "width": 100, "height": 40, "backgroundColor": "#d3f9d8"
    },
    {
      "type": "text", "x": 360, "y": 90, "width": 80, "height": 20, "text": "Inicio", "fontSize": 16, "fontFamily": 1
    },
    { "type": "arrow", "x": 400, "y": 120, "width": 0, "height": 30, "points": [[0,0],[0,30]] },

    { "type": "rectangle", "x": 280, "y": 150, "width": 240, "height": 50, "backgroundColor": "#e8f3ff" },
    { "type": "text", "x": 290, "y": 158, "width": 220, "height": 40, "text": "setup()\nSerial.begin(115200)\nledcAttach(18, 50Hz, 16 bits)", "fontSize": 12, "fontFamily": 1 },
    { "type": "arrow", "x": 400, "y": 200, "width": 0, "height": 30, "points": [[0,0],[0,30]] },

    { "type": "rectangle", "x": 230, "y": 230, "width": 340, "height": 610, "strokeColor": "#000", "strokeStyle": "dashed", "backgroundColor": "transparent" },
    { "type": "text", "x": 240, "y": 240, "width": 150, "height": 20, "text": "loop() - Infinito", "fontSize": 14, "fontFamily": 1 },

    { "type": "rectangle", "x": 280, "y": 280, "width": 240, "height": 50, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 295, "y": 296, "width": 210, "height": 20, "text": "adc_val = analogRead(32)", "fontSize": 13, "fontFamily": 1 },
    { "type": "arrow", "x": 400, "y": 330, "width": 0, "height": 30, "points": [[0,0],[0,30]] },

    { "type": "rectangle", "x": 280, "y": 360, "width": 240, "height": 50, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 288, "y": 372, "width": 224, "height": 30, "text": "angulo = map(adc_val,\n0,4095, 0,180)", "fontSize": 12, "fontFamily": 1 },
    { "type": "arrow", "x": 400, "y": 410, "width": 0, "height": 30, "points": [[0,0],[0,30]] },

    { "type": "rectangle", "x": 280, "y": 440, "width": 240, "height": 50, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 288, "y": 452, "width": 224, "height": 30, "text": "pulso_us = map(angulo,\n0,180, 1000,2000)", "fontSize": 12, "fontFamily": 1 },
    { "type": "arrow", "x": 400, "y": 490, "width": 0, "height": 30, "points": [[0,0],[0,30]] },

    { "type": "rectangle", "x": 280, "y": 520, "width": 240, "height": 50, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 288, "y": 536, "width": 224, "height": 20, "text": "duty = pulso_us*DUTY_MAX/PERIODO_US", "fontSize": 10, "fontFamily": 1 },
    { "type": "arrow", "x": 400, "y": 570, "width": 0, "height": 30, "points": [[0,0],[0,30]] },

    { "type": "rectangle", "x": 280, "y": 600, "width": 240, "height": 50, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 300, "y": 616, "width": 200, "height": 20, "text": "ledcWrite(servo, duty)", "fontSize": 13, "fontFamily": 1 },
    { "type": "arrow", "x": 400, "y": 650, "width": 0, "height": 30, "points": [[0,0],[0,30]] },

    { "type": "rectangle", "x": 280, "y": 680, "width": 240, "height": 60, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 288, "y": 692, "width": 224, "height": 40, "text": "Formatear y emitir:\n[SERVO] adc=... angulo=...\npulso=...us duty=...", "fontSize": 11, "fontFamily": 1 },
    { "type": "arrow", "x": 400, "y": 740, "width": 0, "height": 30, "points": [[0,0],[0,30]] },

    { "type": "rectangle", "x": 280, "y": 770, "width": 240, "height": 50, "backgroundColor": "#ffd8a8" },
    { "type": "text", "x": 300, "y": 786, "width": 200, "height": 20, "text": "delay(100)  // 10 Hz", "fontSize": 13, "fontFamily": 1 },

    { "type": "arrow", "x": 520, "y": 795, "width": 50, "height": 490, "points": [[0,0],[50,0],[50,-490],[-20,-490]] }
  ]
}
