{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "type": "text", "x": 150, "y": 20, "width": 500, "height": 30, "text": "Diagrama UML de Clase Led (Encapsulamiento)", "fontSize": 18, "fontFamily": 1, "textAlign": "center"
    },
    {
      "type": "rectangle", "x": 100, "y": 70, "width": 600, "height": 400, "backgroundColor": "#f8f9fa", "strokeColor": "#343a40"
    },
    {
      "type": "text", "x": 350, "y": 80, "width": 100, "height": 25, "text": "Clase: Led", "fontSize": 16, "fontFamily": 1, "textAlign": "center"
    },
    {
      "type": "line", "x": 100, "y": 110, "width": 600, "height": 0, "points": [[0,0], [600,0]], "strokeColor": "#343a40"
    },
    {
      "type": "rectangle", "x": 110, "y": 120, "width": 580, "height": 170, "backgroundColor": "#d3f9d8", "strokeColor": "#2b8a3e"
    },
    {
      "type": "text", "x": 120, "y": 130, "width": 560, "height": 150, "text": "PUBLIC (Lo que el archivo main.cpp SABE y puede invocar):\n  + Led(pin: uint8_t)\n  + begin(): void\n  + on(): void\n  + off(): void\n  + toggle(): bool\n  + isOn(): bool", "fontSize": 14, "fontFamily": 1
    },
    {
      "type": "rectangle", "x": 110, "y": 300, "width": 580, "height": 160, "backgroundColor": "#ffe3e3", "strokeColor": "#c92a2a"
    },
    {
      "type": "text", "x": 120, "y": 310, "width": 560, "height": 140, "text": "PRIVATE (Lo que el archivo main.cpp NO SABE y NO puede acceder):\n  - _pin: uint8_t   (Número de GPIO asignado)\n  - _state: bool    (Estado interno true/false)\n  - Llamadas al núcleo de Arduino: pinMode(_pin, OUTPUT)\n  - Llamadas al núcleo de Arduino: digitalWrite(_pin, HIGH/LOW)", "fontSize": 14, "fontFamily": 1
    }
  ]
}
