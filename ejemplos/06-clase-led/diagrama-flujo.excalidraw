{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "type": "text", "x": 150, "y": 20, "width": 500, "height": 30, "text": "Diagrama de Flujo del Programa (Llamadas a Métodos de Clase)", "fontSize": 18, "fontFamily": 1, "textAlign": "center"
    },
    {
      "type": "rectangle", "x": 250, "y": 70, "width": 300, "height": 50, "backgroundColor": "#d3f9d8"
    },
    {
      "type": "text", "x": 260, "y": 80, "width": 280, "height": 30, "text": "Instanciación Global\nLed led(2); -> Ejecuta Constructor Led(2)", "fontSize": 13, "fontFamily": 1, "textAlign": "center"
    },
    {
      "type": "arrow", "x": 400, "y": 120, "width": 0, "height": 25, "points": [[0,0], [0,25]]
    },
    {
      "type": "rectangle", "x": 250, "y": 145, "width": 300, "height": 60, "backgroundColor": "#e8f3ff"
    },
    {
      "type": "text", "x": 260, "y": 155, "width": 280, "height": 40, "text": "setup()\n1. Serial.begin(115200)\n2. Llamada a: led.begin() -> [pinMode, LOW]", "fontSize": 13, "fontFamily": 1, "textAlign": "center"
    },
    {
      "type": "arrow", "x": 400, "y": 205, "width": 0, "height": 25, "points": [[0,0], [0,25]]
    },
    {
      "type": "rectangle", "x": 200, "y": 230, "width": 400, "height": 230, "strokeColor": "#000", "strokeStyle": "dashed", "backgroundColor": "transparent"
    },
    {
      "type": "text", "x": 210, "y": 240, "width": 150, "height": 20, "text": "loop() - Infinito (cada 2 s)", "fontSize": 13, "fontFamily": 1
    },
    {
      "type": "rectangle", "x": 250, "y": 270, "width": 300, "height": 50, "backgroundColor": "#fff3bf"
    },
    {
      "type": "text", "x": 260, "y": 280, "width": 280, "height": 30, "text": "1. Llamada a: bool estado = led.toggle()\n-> Invierte digitalWrite(2) y retorna estado", "fontSize": 13, "fontFamily": 1, "textAlign": "center"
    },
    {
      "type": "arrow", "x": 400, "y": 320, "width": 0, "height": 25, "points": [[0,0], [0,25]]
    },
    {
      "type": "rectangle", "x": 250, "y": 345, "width": 300, "height": 50, "backgroundColor": "#ffe3e3"
    },
    {
      "type": "text", "x": 260, "y": 355, "width": 280, "height": 30, "text": "2. Emitir traza Serial\n[LED] estado=ENCENDIDO / APAGADO", "fontSize": 13, "fontFamily": 1, "textAlign": "center"
    },
    {
      "type": "arrow", "x": 400, "y": 395, "width": 0, "height": 25, "points": [[0,0], [0,25]]
    },
    {
      "type": "rectangle", "x": 250, "y": 420, "width": 300, "height": 30, "backgroundColor": "#ffd8a8"
    },
    {
      "type": "text", "x": 260, "y": 427, "width": 280, "height": 20, "text": "3. Retardo: delay(2000)", "fontSize": 13, "fontFamily": 1, "textAlign": "center"
    }
  ]
}
