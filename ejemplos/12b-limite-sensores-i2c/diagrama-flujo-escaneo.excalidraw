{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    { "type": "text", "x": 150, "y": 15, "width": 650, "height": 30, "text": "Diagrama de Flujo — Escáner I2C (direcciones 0x08 a 0x77)", "fontSize": 18, "fontFamily": 1, "textAlign": "center" },

    { "type": "rectangle", "x": 330, "y": 60, "width": 120, "height": 40, "backgroundColor": "#d3f9d8" },
    { "type": "text", "x": 340, "y": 70, "width": 100, "height": 20, "text": "Inicio", "fontSize": 15, "fontFamily": 1, "textAlign": "center" },
    { "type": "arrow", "x": 390, "y": 100, "width": 0, "height": 25, "points": [[0,0],[0,25]] },

    { "type": "rectangle", "x": 230, "y": 125, "width": 320, "height": 50, "backgroundColor": "#d3f9d8" },
    { "type": "text", "x": 240, "y": 135, "width": 300, "height": 32, "text": "setup()\nWire.begin(SDA=21, SCL=22)", "fontSize": 12, "fontFamily": 1, "textAlign": "center" },
    { "type": "arrow", "x": 390, "y": 175, "width": 0, "height": 25, "points": [[0,0],[0,25]] },

    { "type": "rectangle", "x": 170, "y": 200, "width": 700, "height": 615, "strokeStyle": "dashed", "backgroundColor": "transparent" },
    { "type": "text", "x": 180, "y": 208, "width": 150, "height": 18, "text": "loop() - Infinito", "fontSize": 13, "fontFamily": 1 },

    { "type": "rectangle", "x": 250, "y": 225, "width": 360, "height": 40, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 258, "y": 233, "width": 344, "height": 24, "text": "encontrados = 0;  direccion = 0x08", "fontSize": 11, "fontFamily": 1, "textAlign": "center" },
    { "type": "arrow", "x": 430, "y": 265, "width": 0, "height": 20, "points": [[0,0],[0,20]] },

    { "type": "rectangle", "x": 210, "y": 295, "width": 620, "height": 325, "strokeStyle": "dashed", "strokeColor": "#495057", "backgroundColor": "transparent" },
    { "type": "text", "x": 220, "y": 303, "width": 350, "height": 18, "text": "Para direccion = 0x08 .. 0x77", "fontSize": 12, "fontFamily": 1, "strokeColor": "#495057" },

    { "type": "rectangle", "x": 250, "y": 330, "width": 360, "height": 40, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 258, "y": 338, "width": 344, "height": 24, "text": "Wire.beginTransmission(direccion)", "fontSize": 11, "fontFamily": 1, "textAlign": "center" },
    { "type": "arrow", "x": 430, "y": 370, "width": 0, "height": 20, "points": [[0,0],[0,20]] },

    { "type": "rectangle", "x": 250, "y": 390, "width": 360, "height": 40, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 258, "y": 398, "width": 344, "height": 24, "text": "error = Wire.endTransmission()", "fontSize": 11, "fontFamily": 1, "textAlign": "center" },
    { "type": "arrow", "x": 430, "y": 430, "width": 0, "height": 20, "points": [[0,0],[0,20]] },

    { "type": "diamond", "x": 235, "y": 450, "width": 390, "height": 60, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 255, "y": 470, "width": 350, "height": 25, "text": "¿error == 0?  (¿respondió?)", "fontSize": 12, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 625, "y": 480, "width": 25, "height": 0, "points": [[0,0],[25,0]] },
    { "type": "text", "x": 630, "y": 460, "width": 30, "height": 20, "text": "SÍ", "fontSize": 11, "fontFamily": 1 },
    { "type": "rectangle", "x": 650, "y": 450, "width": 280, "height": 60, "backgroundColor": "#ffe3e3" },
    { "type": "text", "x": 658, "y": 458, "width": 264, "height": 44, "text": "Anotar:\nSerial.println(\"[I2C] dispositivo en 0xNN\")\nencontrados++", "fontSize": 10, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 430, "y": 510, "width": 0, "height": 30, "points": [[0,0],[0,30]] },
    { "type": "text", "x": 440, "y": 513, "width": 110, "height": 20, "text": "NO -> seguir\n(no se anota)", "fontSize": 10, "fontFamily": 1 },

    { "type": "rectangle", "x": 250, "y": 545, "width": 360, "height": 40, "backgroundColor": "#e9ecef" },
    { "type": "text", "x": 258, "y": 553, "width": 344, "height": 24, "text": "direccion++", "fontSize": 12, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 610, "y": 565, "width": 40, "height": 215, "points": [[0,0],[40,0],[40,-215],[-40,-215]] },
    { "type": "text", "x": 640, "y": 460, "width": 130, "height": 40, "text": "si direccion\n<= 0x77", "fontSize": 9, "fontFamily": 1, "strokeColor": "#495057" },

    { "type": "text", "x": 250, "y": 592, "width": 400, "height": 20, "text": "direccion > 0x77  ->  sale del for", "fontSize": 11, "fontFamily": 1, "strokeColor": "#868e96" },

    { "type": "arrow", "x": 430, "y": 620, "width": 0, "height": 30, "points": [[0,0],[0,30]] },

    { "type": "rectangle", "x": 250, "y": 655, "width": 360, "height": 45, "backgroundColor": "#d0ebff" },
    { "type": "text", "x": 258, "y": 663, "width": 344, "height": 30, "text": "Serial.println(\"[I2C] N dispositivos encontrados\")", "fontSize": 10, "fontFamily": 1, "textAlign": "center" },
    { "type": "arrow", "x": 430, "y": 700, "width": 0, "height": 25, "points": [[0,0],[0,25]] },

    { "type": "rectangle", "x": 250, "y": 730, "width": 360, "height": 40, "backgroundColor": "#ffd8a8" },
    { "type": "text", "x": 258, "y": 738, "width": 344, "height": 24, "text": "delay(5000)  // repite el escaneo", "fontSize": 12, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 610, "y": 750, "width": 60, "height": 505, "points": [[0,0],[60,0],[60,-505],[-60,-505]] }
  ]
}
