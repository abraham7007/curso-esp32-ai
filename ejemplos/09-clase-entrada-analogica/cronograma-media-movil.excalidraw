{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    { "type": "text", "x": 100, "y": 10, "width": 650, "height": 50, "text": "Cronograma: Código Crudo vs Promedio (N=16) ante un Salto del Cursor", "fontSize": 18, "fontFamily": 1, "textAlign": "center" },

    { "type": "line", "x": 580, "y": 150, "width": 40, "height": 0, "points": [[0,0],[40,0]], "strokeColor": "#e03131", "strokeWidth": 3 },
    { "type": "text", "x": 630, "y": 142, "width": 160, "height": 20, "text": "crudo (instantáneo)", "fontSize": 12, "fontFamily": 1, "strokeColor": "#e03131" },
    { "type": "line", "x": 580, "y": 180, "width": 40, "height": 0, "points": [[0,0],[40,0]], "strokeColor": "#1971c2", "strokeWidth": 3 },
    { "type": "text", "x": 630, "y": 172, "width": 160, "height": 20, "text": "promedio (N=16)", "fontSize": 12, "fontFamily": 1, "strokeColor": "#1971c2" },

    { "type": "line", "x": 80, "y": 280, "width": 480, "height": 0, "points": [[0,0],[480,0]], "strokeColor": "#aaa", "strokeStyle": "dashed" },
    { "type": "text", "x": 15, "y": 272, "width": 60, "height": 20, "text": "500", "fontSize": 12, "fontFamily": 1, "strokeColor": "#495057" },
    { "type": "line", "x": 80, "y": 140, "width": 480, "height": 0, "points": [[0,0],[480,0]], "strokeColor": "#aaa", "strokeStyle": "dashed" },
    { "type": "text", "x": 10, "y": 132, "width": 65, "height": 20, "text": "3500", "fontSize": 12, "fontFamily": 1, "strokeColor": "#495057" },
    { "type": "text", "x": 5, "y": 195, "width": 75, "height": 40, "text": "código\nADC", "fontSize": 11, "fontFamily": 1, "strokeColor": "#495057", "textAlign": "center" },

    { "type": "line", "x": 80, "y": 280, "width": 480, "height": 140, "points": [[0,0],[20,0],[20,-140],[480,-140]], "strokeColor": "#e03131", "strokeWidth": 3 },
    { "type": "line", "x": 80, "y": 280, "width": 480, "height": 140, "points": [[0,0],[20,0],[340,-140],[480,-140]], "strokeColor": "#1971c2", "strokeWidth": 3 },

    { "type": "line", "x": 100, "y": 140, "width": 0, "height": 140, "points": [[0,0],[0,140]], "strokeColor": "#e03131", "strokeStyle": "dashed" },
    { "type": "text", "x": 50, "y": 285, "width": 100, "height": 20, "text": "t=0 (salto)", "fontSize": 11, "fontFamily": 1, "strokeColor": "#e03131", "textAlign": "center" },

    { "type": "line", "x": 420, "y": 140, "width": 0, "height": 140, "points": [[0,0],[0,140]], "strokeColor": "#1971c2", "strokeStyle": "dashed" },
    { "type": "text", "x": 350, "y": 285, "width": 140, "height": 20, "text": "t=N (16 muestras)", "fontSize": 11, "fontFamily": 1, "strokeColor": "#1971c2", "textAlign": "center" },

    { "type": "line", "x": 100, "y": 100, "width": 320, "height": 10, "points": [[0,0],[0,10],[320,10],[320,0]], "strokeColor": "#2b8a3e", "strokeWidth": 2 },
    { "type": "text", "x": 170, "y": 68, "width": 200, "height": 30, "text": "retraso ≈ N muestras\n= 16 × 100 ms = 1.6 s", "fontSize": 13, "fontFamily": 1, "strokeColor": "#2b8a3e", "textAlign": "center" },

    { "type": "text", "x": 80, "y": 440, "width": 540, "height": 55, "text": "El promedio móvil de N=16 muestras sigue al valor crudo con una rampa lineal: tras un salto\ninstantáneo del cursor, el promedio tarda N muestras en alcanzar el nuevo valor estable\n(asentamiento). A 10 muestras/s (delay(100) en loop), el retraso equivale a 1.6 s.", "fontSize": 12, "fontFamily": 1, "strokeColor": "#495057" }
  ]
}
