{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "type": "text", "x": 150, "y": 20, "width": 500, "height": 30, "text": "Procedimiento de Medición de Memoria (Sin WiFi vs Con WiFi)", "fontSize": 18, "fontFamily": 1, "textAlign": "center"
    },
    {
      "type": "rectangle", "x": 250, "y": 70, "width": 300, "height": 50, "backgroundColor": "#e8f3ff"
    },
    {
      "type": "text", "x": 260, "y": 80, "width": 280, "height": 30, "text": "1. Compilar sin la dependencia WiFi\n(Código base solo con GPIO 2)", "fontSize": 13, "fontFamily": 1, "textAlign": "center"
    },
    {
      "type": "arrow", "x": 400, "y": 120, "width": 0, "height": 25, "points": [[0,0], [0,25]]
    },
    {
      "type": "rectangle", "x": 250, "y": 145, "width": 300, "height": 50, "backgroundColor": "#d3f9d8"
    },
    {
      "type": "text", "x": 260, "y": 155, "width": 280, "height": 30, "text": "2. Anotar consumo de RAM y Flash\n(RAM: 21,464 B | Flash: 269,437 B)", "fontSize": 13, "fontFamily": 1, "textAlign": "center"
    },
    {
      "type": "arrow", "x": 400, "y": 195, "width": 0, "height": 25, "points": [[0,0], [0,25]]
    },
    {
      "type": "rectangle", "x": 250, "y": 220, "width": 300, "height": 50, "backgroundColor": "#fff3bf"
    },
    {
      "type": "text", "x": 260, "y": 230, "width": 280, "height": 30, "text": "3. Añadir la dependencia WiFi\n(Descomentar WiFi.h y WiFi.begin)", "fontSize": 13, "fontFamily": 1, "textAlign": "center"
    },
    {
      "type": "arrow", "x": 400, "y": 270, "width": 0, "height": 25, "points": [[0,0], [0,25]]
    },
    {
      "type": "rectangle", "x": 250, "y": 295, "width": 300, "height": 50, "backgroundColor": "#ffe3e3"
    },
    {
      "type": "text", "x": 260, "y": 305, "width": 280, "height": 30, "text": "4. Recompilar proyecto en PlatformIO\n(RAM: 43,424 B | Flash: 724,865 B)", "fontSize": 13, "fontFamily": 1, "textAlign": "center"
    },
    {
      "type": "arrow", "x": 400, "y": 345, "width": 0, "height": 25, "points": [[0,0], [0,25]]
    },
    {
      "type": "rectangle", "x": 250, "y": 370, "width": 300, "height": 50, "backgroundColor": "#ffd8a8"
    },
    {
      "type": "text", "x": 260, "y": 380, "width": 280, "height": 30, "text": "5. Restar valores (Δ = Con WiFi - Sin WiFi)\n(Δ RAM = +21.9 KB | Δ Flash = +444.7 KB)", "fontSize": 13, "fontFamily": 1, "textAlign": "center"
    }
  ]
}
