{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    { "type": "text", "x": 50, "y": 20, "width": 800, "height": 30, "text": "Comparativa de Tamaño: Binario vs JSON (salida real del firmware)", "fontSize": 20, "fontFamily": 1, "textAlign": "center" },

    { "type": "text", "x": 50, "y": 80, "width": 300, "height": 20, "text": "Formato Binario (Crudo):", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1971c2" },
    { "type": "rectangle", "x": 50, "y": 110, "width": 70, "height": 40, "backgroundColor": "#d0ebff" },
    { "type": "text", "x": 55, "y": 120, "width": 60, "height": 20, "text": "[23.7]", "fontSize": 14, "fontFamily": 1, "textAlign": "center" },
    { "type": "rectangle", "x": 130, "y": 110, "width": 60, "height": 40, "backgroundColor": "#d0ebff" },
    { "type": "text", "x": 135, "y": 120, "width": 50, "height": 20, "text": "[57]", "fontSize": 14, "fontFamily": 1, "textAlign": "center" },
    { "type": "rectangle", "x": 200, "y": 110, "width": 80, "height": 40, "backgroundColor": "#d0ebff" },
    { "type": "text", "x": 205, "y": 120, "width": 70, "height": 20, "text": "[1012.3]", "fontSize": 14, "fontFamily": 1, "textAlign": "center" },
    { "type": "rectangle", "x": 290, "y": 110, "width": 70, "height": 40, "backgroundColor": "#d0ebff" },
    { "type": "text", "x": 295, "y": 120, "width": 60, "height": 20, "text": "[3012]", "fontSize": 14, "fontFamily": 1, "textAlign": "center" },
    { "type": "text", "x": 380, "y": 112, "width": 480, "height": 40, "text": "<- Súper eficiente: 4 valores de 4 bytes = 16 bytes,\n    pero ilegible sin conocer el formato", "fontSize": 14, "fontFamily": 1 },

    { "type": "text", "x": 50, "y": 200, "width": 500, "height": 20, "text": "Formato JSON (Texto) — lo que imprime serializeJson():", "fontSize": 16, "fontFamily": 1, "strokeColor": "#2b8a3e" },
    { "type": "rectangle", "x": 50, "y": 230, "width": 800, "height": 40, "backgroundColor": "#d3f9d8" },
    { "type": "text", "x": 60, "y": 240, "width": 780, "height": 20, "text": "{\"temp\":23.70000076,\"hum\":57,\"presion\":1012.299988,\"tiempo_ms\":3012}", "fontSize": 16, "fontFamily": 3 },
    { "type": "text", "x": 50, "y": 285, "width": 800, "height": 40, "text": "<- Fácil de leer por humanos, pero 68 bytes (más \"\\r\\n\" del println): unas 4 veces el binario.\nGasta más por las llaves, las comillas, los nombres y los decimales escritos como texto.", "fontSize": 13, "fontFamily": 1 },

    { "type": "rectangle", "x": 50, "y": 350, "width": 800, "height": 75, "strokeColor": "#495057", "backgroundColor": "#f8f9fa" },
    { "type": "text", "x": 62, "y": 358, "width": 776, "height": 60, "text": "¿Por qué 23.70000076 y no 23.7? 23.7 no es exacto en binario: el float guarda 23.700000762…\nArduinoJson 6 en el ESP32 trabaja con double (ARDUINOJSON_USE_DOUBLE = 1) y escribe esas cifras.\nEl largo varía con los valores (p. ej. {\"temp\":20,\"hum\":40,\"presion\":1010,\"tiempo_ms\":12} ocupa 50 bytes).", "fontSize": 12, "fontFamily": 1, "textAlign": "center" }
  ]
}
