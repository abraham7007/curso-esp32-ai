  "elements": [
    { "type": "text", "x": 50, "y": 20, "width": 700, "height": 30, "text": "Comparativa de Tamaño: Binario vs JSON", "fontSize": 20, "fontFamily": 1, "textAlign": "center" },
    
    { "type": "text", "x": 50, "y": 80, "width": 200, "height": 20, "text": "Formato Binario (Crudo):", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1971c2" },
    { "type": "rectangle", "x": 50, "y": 110, "width": 60, "height": 40, "backgroundColor": "#d0ebff" },
    { "type": "text", "x": 60, "y": 120, "width": 40, "height": 20, "text": "[25.4]", "fontSize": 14, "fontFamily": 1, "textAlign": "center" },
    { "type": "rectangle", "x": 120, "y": 110, "width": 60, "height": 40, "backgroundColor": "#d0ebff" },
    { "type": "text", "x": 130, "y": 120, "width": 40, "height": 20, "text": "[60]", "fontSize": 14, "fontFamily": 1, "textAlign": "center" },
    { "type": "rectangle", "x": 190, "y": 110, "width": 80, "height": 40, "backgroundColor": "#d0ebff" },
    { "type": "text", "x": 200, "y": 120, "width": 60, "height": 20, "text": "[1010.5]", "fontSize": 14, "fontFamily": 1, "textAlign": "center" },
    { "type": "text", "x": 290, "y": 120, "width": 400, "height": 20, "text": "<- Súper eficiente (~12 bytes), pero difícil de leer", "fontSize": 14, "fontFamily": 1 },

    { "type": "text", "x": 50, "y": 200, "width": 200, "height": 20, "text": "Formato JSON (Texto):", "fontSize": 16, "fontFamily": 1, "strokeColor": "#2b8a3e" },
    { "type": "rectangle", "x": 50, "y": 230, "width": 400, "height": 40, "backgroundColor": "#d3f9d8" },
    { "type": "text", "x": 60, "y": 240, "width": 380, "height": 20, "text": "{\"temp\":25.4,\"hum\":60,\"presion\":1010.5}", "fontSize": 16, "fontFamily": 1 },
    { "type": "text", "x": 470, "y": 235, "width": 300, "height": 40, "text": "<- Fácil de leer por humanos (~39 bytes)\nGasta más memoria por las llaves y nombres.", "fontSize": 12, "fontFamily": 1 }
  ]
}
