{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    { "type": "text", "x": 100, "y": 20, "width": 600, "height": 30, "text": "Diagrama de Flujo: Petición Autenticada a OpenWeatherMap", "fontSize": 20, "fontFamily": 1, "textAlign": "center" },

    { "type": "rectangle", "x": 250, "y": 80, "width": 300, "height": 40, "backgroundColor": "#d3f9d8" },
    { "type": "text", "x": 260, "y": 90, "width": 280, "height": 20, "text": "¿Pasaron 60 segundos?", "fontSize": 16, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 400, "y": 120, "width": 0, "height": 40, "points": [[0,0],[0,40]] },

    { "type": "rectangle", "x": 200, "y": 160, "width": 400, "height": 60, "backgroundColor": "#e8f3ff" },
    { "type": "text", "x": 210, "y": 170, "width": 380, "height": 40, "text": "HTTP GET (Incluye API KEY en URL)\nhttp://.../weather?q=Curitiba&appid=TU_LLAVE", "fontSize": 14, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 400, "y": 220, "width": 0, "height": 40, "points": [[0,0],[0,40]] },

    { "type": "diamond", "x": 250, "y": 260, "width": 300, "height": 60, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 260, "y": 280, "width": 280, "height": 20, "text": "¿Código HTTP == 200?", "fontSize": 14, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 550, "y": 290, "width": 60, "height": 0, "points": [[0,0],[60,0]] },
    { "type": "text", "x": 560, "y": 270, "width": 40, "height": 20, "text": "NO", "fontSize": 14, "fontFamily": 1 },
    
    { "type": "rectangle", "x": 630, "y": 260, "width": 180, "height": 60, "backgroundColor": "#ffe3e3" },
    { "type": "text", "x": 640, "y": 270, "width": 160, "height": 40, "text": "Si es 401 (Unauthorized)\n¡Falta API KEY!", "fontSize": 12, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 400, "y": 320, "width": 0, "height": 40, "points": [[0,0],[0,40]] },
    { "type": "text", "x": 410, "y": 330, "width": 40, "height": 20, "text": "SÍ", "fontSize": 14, "fontFamily": 1 },

    { "type": "rectangle", "x": 200, "y": 360, "width": 400, "height": 60, "backgroundColor": "#d3f9d8" },
    { "type": "text", "x": 210, "y": 370, "width": 380, "height": 40, "text": "deserializeJson(doc, payload);\nc = doc[\"name\"], t = doc[\"main\"][\"temp\"], h = doc[\"main\"][\"humidity\"]", "fontSize": 12, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 400, "y": 420, "width": 0, "height": 40, "points": [[0,0],[0,40]] },

    { "type": "rectangle", "x": 250, "y": 460, "width": 300, "height": 60, "backgroundColor": "#d0ebff" },
    { "type": "text", "x": 260, "y": 470, "width": 280, "height": 40, "text": "Imprimir en Serial\nDibujar en OLED", "fontSize": 14, "fontFamily": 1, "textAlign": "center" }
  ]
}
