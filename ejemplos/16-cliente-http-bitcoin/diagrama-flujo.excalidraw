{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    { "type": "text", "x": 100, "y": 20, "width": 600, "height": 30, "text": "Diagrama de Flujo: Cliente HTTP y Parseo de JSON", "fontSize": 20, "fontFamily": 1, "textAlign": "center" },
    
    { "type": "rectangle", "x": 200, "y": 80, "width": 400, "height": 60, "backgroundColor": "#e8f3ff" },
    { "type": "text", "x": 210, "y": 95, "width": 380, "height": 30, "text": "1. Conectar al WiFi (Wokwi-GUEST)", "fontSize": 16, "fontFamily": 1, "textAlign": "center" },
    
    { "type": "arrow", "x": 400, "y": 140, "width": 0, "height": 40, "points": [[0,0],[0,40]] },
    
    { "type": "rectangle", "x": 200, "y": 180, "width": 400, "height": 60, "backgroundColor": "#d3f9d8" },
    { "type": "text", "x": 210, "y": 195, "width": 380, "height": 30, "text": "2. Realizar petición HTTP GET a CoinGecko", "fontSize": 16, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 400, "y": 240, "width": 0, "height": 40, "points": [[0,0],[0,40]] },
    
    { "type": "diamond", "x": 250, "y": 280, "width": 300, "height": 60, "backgroundColor": "#fff3bf" },
    { "type": "text", "x": 260, "y": 300, "width": 280, "height": 30, "text": "¿Código HTTP == 200 (OK)?", "fontSize": 14, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 550, "y": 310, "width": 60, "height": 0, "points": [[0,0],[60,0]] },
    { "type": "text", "x": 560, "y": 290, "width": 40, "height": 20, "text": "NO", "fontSize": 14, "fontFamily": 1 },
    
    { "type": "rectangle", "x": 620, "y": 280, "width": 150, "height": 60, "backgroundColor": "#ffe3e3" },
    { "type": "text", "x": 630, "y": 300, "width": 130, "height": 30, "text": "Imprimir Error", "fontSize": 14, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 400, "y": 340, "width": 0, "height": 40, "points": [[0,0],[0,40]] },
    { "type": "text", "x": 410, "y": 350, "width": 40, "height": 20, "text": "SÍ", "fontSize": 14, "fontFamily": 1 },
    
    { "type": "rectangle", "x": 200, "y": 380, "width": 400, "height": 60, "backgroundColor": "#e8f3ff" },
    { "type": "text", "x": 210, "y": 395, "width": 380, "height": 30, "text": "3. Guardar String: {\"bitcoin\":{\"usd\":62500}}", "fontSize": 16, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 400, "y": 440, "width": 0, "height": 40, "points": [[0,0],[0,40]] },
    
    { "type": "rectangle", "x": 200, "y": 480, "width": 400, "height": 60, "backgroundColor": "#d3f9d8" },
    { "type": "text", "x": 210, "y": 495, "width": 380, "height": 30, "text": "4. deserializeJson(doc, string)", "fontSize": 16, "fontFamily": 1, "textAlign": "center" },

    { "type": "arrow", "x": 400, "y": 540, "width": 0, "height": 40, "points": [[0,0],[0,40]] },

    { "type": "rectangle", "x": 200, "y": 580, "width": 400, "height": 60, "backgroundColor": "#d3f9d8" },
    { "type": "text", "x": 210, "y": 590, "width": 380, "height": 40, "text": "5. Extraer: float precio = doc[\"bitcoin\"][\"usd\"]\nImprimir en Consola", "fontSize": 14, "fontFamily": 1, "textAlign": "center" },
    
    { "type": "arrow", "x": 200, "y": 610, "width": -150, "height": -400, "points": [[0,0],[-150,0],[-150,-400],[0,-400]] },
    { "type": "text", "x": 60, "y": 400, "width": 100, "height": 20, "text": "Esperar 60s", "fontSize": 14, "fontFamily": 1 }
  ]
}
