	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"playwright": "^1.62.0",
		"vite": "^8.1.1"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@wokwi/elements": "^1.9.2",
		"tailwindcss": "^4.3.3"
	}
}
